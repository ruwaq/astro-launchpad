{
  "name": "astrogate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-sw.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run lint && npm run test && npm run smoke:render && npm run verify:pwa && npm run check:csp",
    "check:csp": "node scripts/check-csp.mjs",
    "deploy": "npm run build && (export CLOUDFLARE_API_TOKEN=\"${CLOUDFLARE_API_TOKEN:-$(cat ~/.config/cloudflare/cf-api-token 2>/dev/null)}\"; npx -y wrangler@3.114.0 deploy)",
    "smoke:render": "node scripts/smoke-render.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "preview": "vite preview",
    "bindings": "node scripts/generate-bindings.mjs",
    "verify:launchpad": "node scripts/verify-launchpad.mjs",
    "verify:soroswap": "node scripts/verify-soroswap.mjs",
    "verify:discovery": "node scripts/verify-discovery.mjs",
    "verify:token-events": "node scripts/verify-token-events.mjs",
    "verify:demo": "node scripts/verify-demo.mjs",
    "verify:frontend": "node scripts/verify-frontend-flow.mjs"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
