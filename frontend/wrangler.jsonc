{
  // Frontend de Floodgate como Cloudflare Worker con assets estáticos.
  // SPA fallback nativo: cualquier ruta cae en index.html.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floodgate-stellar",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
