{
  // AstroGate Frontend as a Cloudflare Worker with static assets.
  // Native SPA fallback: all routes fall back to index.html.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astrogate-stellar",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
